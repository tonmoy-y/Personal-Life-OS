# Copy to .env.local for local development. NEVER commit real values.
# Both values are safe to expose to the browser (publishable key only; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL of this deployment (used for auth email redirects). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: no service-role key is needed or used anywhere in this app.
# Account deletion uses the RLS-safe `delete_my_account()` SQL function.
